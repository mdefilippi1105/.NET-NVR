@using Microsoft.AspNetCore.Hosting.StaticWebAssets
@*****************************************************************************************
This is the master template for our app. Its the wrapper that holds all the shared HTML
that appears on every page: <html>, <head>, navbar, footer
IMPORTANT: ICONS ARE 9090b8 / 60px
*****************************************************************************************@

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name = "viewport" content = "width=device-width, initial-scale=1.0"/>
    <title>igiEngine</title>
    
    
    <!-- load bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    

</head>

<body style="background-color: #0d1117;">
<!-- Top navigation bar -->
<nav class="navbar navbar-dark px-4">
    
    <a class="navbar-brand" href="/Home"style="font-size: 2.5rem; font-family: 'JetBrains Mono'; letter-spacing: 0.1em;">
        <img src="~/Images/igicircle.png" alt="" width="75" height="75">    igiEngine
    </a>
</nav>

<!-- Every page's content gets injected here -->
@RenderBody()

<!-- Load Bootstrap JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Load Sweet Alert JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>





@*****************************************************
* CSS Styles
******************************************************@
    <style>
        
        /* buttons  */
        .btn-ffx {
            background:#1e2550; 
            border:1px solid #330860;
            font-size: 1.20rem;
            color: #ffffff;
            font-family: system-ui;
            transition: background .15s, border-color .15s, color .15s;
            cursor: pointer;
        }
        .btn-ffx:hover {
            background: #2a3270 !important;
            border-color: #6655cc !important;
            color: #fff !important;
            transform: translateY(-2px);
            box-shadow: 0 0 10px rgba(102, 85, 204, 0.5);
            animation: ffx-pulse 1s infinite;
        }

        /* this is the header of the main camera table  */
        .table thead th {
            font-family: system-ui;
            font-size: 1rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: #7a88bb;
            border-bottom: 1px solid #2e3660;

        }

        /* the main camera table  */
        .table-dark {
            --bs-table-bg: transparent;
            --bs-table-striped-bg: rgba(255, 255, 255, 0.03);
            --bs-table-hover-bg: rgba(255, 255, 255, 0.07);
            --bs-table-border-color: #2e3660;
            font-family: system-ui;
            font-size: 1.35rem;
            color: #ccd6f6;
            background: linear-gradient(to right, #2e2a55, #4a4080);
            animation: fade-up 0.4s ease;
        }

        body {
            background-color: #10163b;
        }
        
        .navbar {
            background-image: url('/Images/lightheader.svg');
            background-size: 100% 100%;
            background-repeat: no-repeat;
            height:100px;
            width: 100%;
        }
        .form-label{
            color: #d1d0d2;
        }
        .form-check-label{
            color: #d1d0d2;
        }
        .form-check{
            color: #d1d0d2;
        }

        .form-control {
            background: linear-gradient(to right, #2e2a55, #4a4080);
            font-family: system-ui;
            border: 1px solid #7a6fb0;
            border-radius: 6px;
            color: #ffffff;
            animation: fade-up 0.4s ease;
        }
        .form-select {
            background: linear-gradient(to right, #2e2a55, #4a4080);
            font-family: system-ui;
            border: 1px solid #7a6fb0;
            border-radius: 6px;
            color: #ffffff;
            animation: fade-up 0.4s ease;
        }
        .form-select option {
            background: #2e2a55;
            color: #ffffff;
        }

        .form-select:focus {
            border-color: #a99ce0;
            outline: none;
        }
        

        .form-control:focus {
            animation: ffx-pulse 1.5s ease-in-out infinite;
            background: linear-gradient(to right, #3a3560, #5a4e90);
            color: #ffffff;
            box-shadow: 0 0 0 2px rgba(200, 168, 64, 0.25);
        }

        .form-control::placeholder {
            color: #9090b8;
        }
        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #383657;
            display: inline-block;
            vertical-align: middle;
        }

        .dot.online {
            background: limegreen;
            animation: pulse 1s infinite;
        }

        .dot.offline {
            background: #383657;
            
        }

        .modal-header {
            border-bottom: 0;
            
        }
        .modal-footer {
            align-items: center;
            display: flex;
            margin-bottom: 12px;
            flex-direction: row;
            gap: 12px; 
        }
        .modal-footer form {
            align-items: center;
            width: 100%;
        }

        /* no body rule — it would override the whole site */
        .launcher { 
            flex:1; 
            padding:8px 24px; }

        .section-title {
            color:#6e7a9a; 
            font-size:22px; 
            font-weight:400;
            text-transform:uppercase; 
            letter-spacing:.07em;   /* matches your "Users" header */
            padding-bottom:8px; 
            margin:20px 0 18px;
            border-bottom:1px solid #330860;
        }

        .tile-grid {
            display:grid;
            grid-template-columns:repeat(auto-fill, 130px);   /* fill-as-many-as-fit, then wrap */
            gap:14px 28px;
        }

        .tile {
            animation: fade-up 0.4s ease;

            display:flex; 
            flex-direction:column; 
            align-items:center; 
            gap:8px;
            background:none; 
            border:none; 
            color:#fafafa;
            cursor:pointer; 
            padding:6px; 
            width:130px; 
            font-size:14px; 
            text-align:center;
        }
        .tile-icon {
            width:64px; 
            height:64px; 
            border-radius:6px;
            background:#1e2550; 
            border:1px solid #330860;
            display:flex; 
            align-items:center; 
            justify-content:center; 
            font-size:30px;
            transition:background .12s, border-color .12s;
        }
        .tile:hover .tile-icon {
            animation: ffx-pulse 1s infinite;
            background:#2a3470; 
            border-color:#6e3fd1; 
        }
        .tile:focus-visible .tile-icon { 
            outline:2px solid #6e3fd1; 
            outline-offset:2px; 
        }

        @@keyframes ffx-pulse {
            0%,100% { box-shadow: 0 0 0 1px rgb(42, 50, 112); }
            50%      { box-shadow: 0 0 0 3px rgb(102, 85, 204); }
        }
        
        
        
        @@keyframes fade-up {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        
        @@keyframes pulse {
            0%   { box-shadow: 0 0 0 0 rgba(50, 205, 50, 0.7); }
            70%  { box-shadow: 0 0 0 8px rgba(50, 205, 50, 0); }
            100% { box-shadow: 0 0 0 0 rgba(50, 205, 50, 0); }
            
        }
        @@keyframes pulse-red {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 43, 66, 0.7); }
            70%      { box-shadow: 0 0 0 8px rgba(255, 0, 0, 0); }
        }
        
        .pulse-red-recording {
            border: 1px solid #ff2b42 !important;   /* overrides your inline border */
            box-shadow: 0 0 0 0 rgba(255, 43, 66, 0);  /* explicit start state */
            transition: none !important;
            animation: pulse-red 2s ease-in-out infinite;
        }
        @@keyframes pulse-red-recording {
            0%   { box-shadow: 0 0 0 0 rgba(255, 43, 66, 0.5); }
            100% { box-shadow: 0 0 0 6px rgba(255, 43, 66, 0); }
        }

        .record-btn.pending {
            animation: pending-fade 0.8s ease-in-out infinite;
            cursor: wait;              /* cursor changes on hover */
        }
        @@keyframes pending-fade {
            0%, 100% { opacity: 0.4; }
            50%      { opacity: 0.8; }
        }
        .status-wrap {
            flex: 1;
            padding: 24px 28px;
            color: #fafafa;
        }

        .status-head {
            display: flex;
            align-items: baseline;
            gap: 14px;
            padding-bottom: 14px;
            border-bottom: 1px solid #1e2550;
            margin-bottom: 22px;
        }

        .status-head h1 {
            font-size: 28px;
            margin: 0;
            letter-spacing: .01em;
        }

        .status-eyebrow {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #6e7a9a;
        }

        .pill {
            margin-left: auto;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .1em;
            padding: 5px 12px;
            border-radius: 999px;
            border: 1px solid #330860;
            background: #1e2550;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .server-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #6e7a9a;
        }

        .server-dot.live {
            background: #47d16c;
            box-shadow: 0 0 0 0 rgba(71, 209, 108, .55);
            animation: pulse 2s infinite;
        }

        .server-dot.warn { background: #e0b13a; }

        .srv-btn {
            background: #1e2550;
            border: 1px solid #330860;
            color: #fafafa;
            display: inline-flex;
            align-items: center;
            gap: 15px;
        }

        @@keyframes pulse {
            70%  { box-shadow: 0 0 0 7px rgba(71, 209, 108, 0); }
            100% { box-shadow: 0 0 0 0 rgba(71, 209, 108, 0); }
        }

        @@media (prefers-reduced-motion: reduce) {
        .server-dot.live { animation: none; }
        }

        .field-grid {
            animation: fade-up 0.4s ease;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
        }

        .field {
            animation: fade-up 0.4s ease;
            background: #0d1117;
            border: 1px solid #1e2550;
            border-left: 3px solid #330860;
            border-radius: 6px;
            padding: 14px 16px;
        }

        .field-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: #6e7a9a;
            margin-bottom: 6px;
        }

        .field-value {
            font-size: 20px;
            word-break: break-all;
        }

        .field-value.mono {
            font-family: Consolas, "Courier New", monospace;
            font-size: 15px;
        }

        .field-sub {
            font-size: 12px;
            color: #6e7a9a;
            margin-top: 4px;
        }

        .empty {
            background: #0d1117;
            border: 1px dashed #330860;
            border-radius: 6px;
            padding: 40px;
            text-align: center;
            color: #6e7a9a;
        }
    </style>
    

@*****************************************************
* GLOBAL POP UP HANDLERS
when we perform an IAction or any other function we
need to set TempData["keyword"]. based on the keywords
we put in TempData["keyword"] it will trigger the alert
below. 
******************************************************@

@**@
@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            title: 'Success!',
            text: '@TempData["Success"]',
            icon: 'success',
            confirmButtonText: 'OK',
            showCancelButton: false,
            background: '#1a1a2e',
            color: '#f8fafc',
            confirmButtonColor: '#6655cc',
            cancelButtonColor: '#334155'

        })
    </script>
}
@**@
@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
            title: 'Error!',
            text: '@TempData["Error"]',
            icon: 'error',
            showConfirmButton: true,
            timer: 2000,
            background: '#1a1a2e',        // dark background
            color: '#ffffff',             // white text
            confirmButtonColor: '#6655cc' 

        })
    </script>
}
@*
This popup appears when deleting a camera. If yes is clicked, delete.
*@
@if (TempData["PleaseConfirm"] != null)
{
    <script>
        Swal.fire({
            title: 'Are you sure?',
            text: '@TempData["PleaseConfirm"]',
            icon: 'warning',
            showConfirmButton: true,
            showCancelButton: true,
            ConfirmButtonText: 'Yes',
            cancelButtonText: 'No',
            background: '#1a1a2e',        // dark background
            color: '#ffffff',             // white text
            confirmButtonColor: '#6655cc' // bootstrap blue
        }).then((result) => {
            if (result.isConfirmed) {
                
            }
        });
    </script>
}

@if (TempData["ConnectFail"] != null)
{
    <script>
        Swal.fire({
            title: 'Connection timed out.',
            text: '@TempData["ConnectFail"]',
            icon: 'warning',
            showConfirmButton: true,
            showCancelButton: true,
            ConfirmButtonText: 'Yes',
            cancelButtonText: 'No',
            background: '#1a1a2e',        // dark background
            color: '#ffffff',             // white text
            confirmButtonColor: '#6655cc' // bootstrap blue
        }).then((result) => {
            if (result.isConfirmed) {

            }
        });
    </script>
}

</body>

</html>
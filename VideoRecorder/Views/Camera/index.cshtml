    @*******************************TABLE HEADERS********************************@
    @* this is the sort form *@

    <table class= "table table-striped table-dark table-hover" style="align-self:start; width:auto; margin-top:97px;">
        <thead class="table-dark ">
        <tr>
            <th style="width:150px;">Name</th>
            <th style="width:150px;">Description</th>
            <th style="width:150px;">Enabled</th>
            <th style="width:150px;">Protocol</th>
            <th style="width:120px;">Online</th>
            <th style="width:150px;">Recording</th>
            <th style="width:150px;">Live</th>
            <th style="width:150px;">Edit</th>
            <th style="width:150px;">Delete</th>
            
        </tr>
        </thead>
        
        <tbody>
        
        @************************************************************************* 
        ***************************** TABLE BODY *********************************
                        loop through every camera and display in a row 
                            add a button next to each entry 
        *************************************************************************@
        
        @foreach (var camera in Model)
        {
            <tr>
                <input type="hidden" name="Id" value="@camera.Id"/>
                <td>@camera.Name</td>
                <td>@camera.Description</td>
                <td>@(camera.IsEnabled ? "Yes" : "No")</td>
                
                
                @* this creates a badge based on how the device was added. 
                     i will add more protocol badges as time goes on.
                     RtspUrl?.ToLower().Contains converts the text to lower and then runs a check *@
                <td>
                    @if (camera.RtspUrl != null 
                         && camera.RtspUrl?.ToLower().Contains("onvif") == true)
                    {
                        <span style="color: #c4c4f3; background: transparent;border: 1px solid #c4c4f3; font-family: 'Courier New', monospace;" class="badge">ONVIF</span> 
                    }

                    else if (camera.RtspUrl != null 
                             && camera.RtspUrl?.ToLower().Contains("rtsp") == true)
                    {
                        <span style="color: #fa8080; background: transparent;border: 1px solid #FA8080FF; font-family: 'Courier New', monospace;" class="badge ">RTSP</span>
                    }
                    
                    // indicative the cam was added manually
                    // is there a better way? probably
                    else if (camera.Manufacturer != null) 
                    {
                        <span style="color: #64d01c; background: transparent;border: 1px solid #64d01c; font-family: 'Courier New', monospace;" class="badge ">STREAM</span>
                    }
                </td>
                <td>
                    <span id="status-@camera.Id" class="dot"> </span>
                </td>
                
                <td>
                    <form
                        asp-controller="Recording"
                        asp-action="ToggleRecording"
                        asp-route-id="@camera.Id"
                        method="post"
                        class="d-inline">
                        <button
                            id="record-@camera.Id"
                            data-camera-id="@camera.Id"
                            class="btn btn-sm btn-ffx record-btn @(camera.IsRecording && camera.IsOnline ? "pulse-red-recording" : "")"
                            style="background:#1e2550;
                            border:1px solid #330860;
                            color:#fafafa;
                            width: 75px;"
                            type="submit">
                        @* we  put  the @ sign here to run c# commands within this line*@
                        <img
                            id="record-img-@camera.Id"
                            src="~/Images/@(camera.IsRecording ? "record-on.png" : "record-off.png")"
                             alt="" width="30" height="30">
                    </button>
                    </form>
                </td>
                
                
                @* This is a check to see how the camera was added to the db.
                    If the camera was added with the rtsp URL > use OpenRtspSession
                    If the camera was added manually > use OpenCameraObjectSession *@
                <td>
                    @{
                        string action;
                        if (camera.Manufacturer.IsNullOrEmpty())
                            action = "OpenRtspSession";
                        else
                            action = "OpenCameraObjectSession";
                    }
                    <a asp-action="@action"
                       asp-route-id="@camera.Id"
                       class="btn btn-sm btn-ffx"
                       style="background:#1e2550; 
                       border:1px solid #330860; 
                       color:#fafafa;"
                       button type="button"
                       data-toggle="tooltip"
                       data-placement="top"
                       title="View camera stream live">Live
                        <img src="~/Images/live.png" alt="" width="30" height="30">
                    </a>
                    
                </td>
                <td>
                    @{
                        string editAction;
                        if (camera.RtspUrl == null)
                            editAction = "EditCamera";
                        else
                            editAction = "EditRtsp";
                    }                   
                    <a asp-action="@editAction"
                       asp-route-id="@camera.Id"
                       class="btn btn-sm btn-ffx"
                       style="background:#1e2550; 
                       border:1px solid #330860; 
                       color:#fafafa;"
                       button type="button"
                       data-toggle="tooltip"
                       data-placement="top"
                       title="Edit device">Edit
                        <img src="~/Images/edit.png" alt="" width="30" height="30">
                    </a>
                </td>

                <td>
                    <a onclick="confirmRemove('@camera.Id')"
                       class="btn btn-sm btn-ffx"
                       style="background:#1e2550; 
                       border:1px solid #330860; 
                       color:#fafafa;"
                       button type="button"
                       data-toggle="tooltip"
                       data-placement="top"
                       title="Delete device">Delete
                        <img src="~/Images/delete.png" alt="" width="30" height="30">
                    </a>
                </td>

                
            </tr>
        }
        </tbody>
    </table>
    
    

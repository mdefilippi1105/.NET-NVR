@{
    ViewData["Title"] = "Manage Users";
}
@model List<VideoRecorder.Models.User>
<h1> Manage Users </h1>

<div style="display:flex;">
    
     @*********************************************** 
    this is the entire tool bar starting at the div
    
    ***********************************************@
    <div style="width:160px; 
        min-width:200px; 
        background:#0d1117; 
        border-right:1px solid #330860; 
        padding:16px 12px; 
        display:flex; 
        flex-direction:column; 
        gap:8px;">

        <p style="font-size:22px; 
            color:#6e7a9a; 
            text-transform:uppercase; 
            letter-spacing:.07em;
            padding-bottom:10px;
            border-bottom:1px solid #1e2550;
            margin:0;">Users</p>


        <!--Add new user -->
        <a asp-action="Create"
           class="btn btn-sm btn-ffx"
           style="background:#1e2550; 
                  border:1px solid #330860; 
                  color:#fafafa;
                  display:flex; 
                  align-items:center; 
                  gap:8px;"
           data-toggle="tooltip"
           data-placement="top"
           title="Tooltip on top">
            <img src="~/Images/newuser.png" alt="" width="45" height="45">
            New User
        </a>

        <!--Edit user -->
        <button type="button"
           class="btn btn-sm btn-ffx"
           style="background:#1e2550; 
                  border:1px solid #330860; 
                  color:#fafafa;
                  display:inline-flex; 
                  align-items:center; 
                  gap:8px;"
           data-bs-toggle="modal"
           data-bs-target="#editUserModal">
            <img src="~/Images/edituser.png" alt="" width="45" height="45">
            Edit User
        </button>
        
        <!-- Back to cameras   -->
        <a
            asp-controller="Camera"
            asp-action="Index"
            class="btn btn-sm btn-ffx"
            style="background:#1e2550; 
                   border:1px solid #330860; 
                   color:#fafafa;
                   display:flex; 
                   align-items:center; 
                   gap:8px;">
            <img src="~/Images/cam.png" alt="" width="45" height="45">
            Return to Cams
        </a>
        
        <a asp-controller="Home" 
           asp-action="Index" 
           class="btn btn-ffx" 
           style="background:#1e2550; 
                  border:1px solid #330860; 
                  color:#fafafa;
                  display:flex; 
                  align-items:center; 
                  gap:8px;">
            <img src="~/Images/home.png" alt="" width="45" height="45">
            igiEngine Home
        </a>
        
        <a asp-controller="Account" 
           asp-action="Logout" 
           class="btn btn-ffx"
           style="background:#1e2550; 
                  border:1px solid #330860; 
                  color:#fafafa;
                  display:flex; 
                  align-items:center; 
                  gap:8px;">
            <img src="~/Images/exit.png" alt="" width="60" height="45">
            Logout
        </a>
    </div>
    
    
   
        @* this is the sort form *@

        <table class="table table-sm table-striped table-dark table-hover align-middle" style="align-self:start; width:auto; margin-top:69px">
            <thead class="table-dark table-sm" style="align-self:start; ">
            <tr>
                <th style="width:150px;"></th>
                <th style="width:150px;">Name</th>
                <th style="width:150px;">Description</th>
                <th style="width:150px;">Enabled</th>

            </tr>
            </thead>

            <tbody>
            @*  the table rows  *@
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(user.PhotoPath))
                        {
                            <img src="@user.PhotoPath" width="40" height="40"
                                 class="rounded-circle" style="object-fit:cover;" alt="@user.Username"/>
                        }
                        else
                        {
                            <span class="text-scondary">-</span>
                        }
                    </td>
                    <input type="hidden" name="Id" value="@user.Id"/>
                    <td>@user.Username</td>
                    <td>@user.Role</td>
                    <td>@(user.IsEnabled ? "Yes" : "No")</td>
                </tr>
            }
            </tbody>
            
        </table>        



</div>@* end tool bar   *@


@* modal that gets generated for editing a user   *@
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header">
                <h5 class="modal-title">Edit User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body"> @* here is the dropdown that selects a user*@
                <select id="userSelect" class="form-select">
                    <option value="">--Select a user--</option>
                    @foreach (var user in Model)
                    {
                        <option value="@user.Id">@user.Username</option>
                    }
                </select>

            </div>
            <div class="modal-footer">
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="editBtn" class="btn btn-primary" disabled>Edit</button>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    const select = document.getElementById('userSelect');
    const editBtn = document.getElementById('editBtn');
    select.onchange = () => editBtn.disabled = !select.value;
    editBtn.onclick = () => location.href = '/User/Edit/' + select.value;
</script>



